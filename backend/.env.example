# ============================================================
# AI Accountant environment configuration (copy to .env)
# ============================================================

# --- Core ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ENCRYPTION_KEY=  # Fernet key (32-byte urlsafe base64). Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database ---
# Local SQLite (zero setup) or Postgres+pgvector via docker compose.
DATABASE_URL=sqlite:///./ai-accountant.db
# DATABASE_URL=postgresql+psycopg2://aiaccountant:aiaccountant@localhost:5433/aiaccountant

# --- LLM provider (provider-agnostic) ---
# Set one of: mock | openrouter | openai | anthropic | moonshot | deepseek | ollama
LLM_PROVIDER=mock
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
MODEL_LIGHT=
MODEL_STANDARD=
MODEL_HEAVY=
# Price per 1M tokens, "model:prompt_price:completion_price" pairs separated by "|"
MODEL_PRICING=
DEFAULT_MONTHLY_AI_BUDGET_USD=50

# --- Embeddings ---
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=384

# --- Jobs ---
SCHEDULER_ENABLED=true

# --- Document storage ---
DOCUMENT_STORAGE_PATH=./data/documents
